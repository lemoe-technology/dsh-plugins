{
  "name": "@lemoe-internal/dsh-client-theme-vscode-2026-dark",
  "version": "1.0.0",
  "description": "VSCode 2026 Dark theme",
  "homepage": "https://github.com/lemoe-technology/dsh-plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemoe-technology/dsh-plugins.git"
  },
  "license": "MIT",
  "author": "Lemoe",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets/icon.png",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
