    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "icon": "./assets/icon.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
